# ============================================================
# Clipe233 Engineers — Environment Variables
# ============================================================
# Copy this file to .env on your VPS and fill in real values.
# DO NOT commit the real .env file to git.
# ============================================================

# ── Database ──────────────────────────────────────────────
# SQLite (simplest — works on any VPS)
DATABASE_URL="file:./db/custom.db"

# For MySQL (recommended for production on Webuzo):
# DATABASE_URL="mysql://db_user:db_password@localhost:3306/clipe233_db"

# ── Site URL ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://clipe233eng.net"

# ── Admin Credentials ────────────────────────────────────
# CHANGE THESE before going live!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisToAStrongPassword123!"

# ── Email Configuration (SMTP) ───────────────────────────
# Used for contact form submissions and auto-replies
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="clipeconsult@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="clipeconsult@gmail.com"
EMAIL_TO="clipeconsult@gmail.com, info@clipeconsult.com"

# ── Tawk.to Live Chat (already hardcoded in layout) ──────
# Not needed in env, but documented here for reference
NEXT_PUBLIC_TAWK_PROPERTY_ID="6a471aaa539b7e1d4b7d3457"
NEXT_PUBLIC_TAWK_WIDGET_ID="1jsis0aos"

# ── Optional: WhatsApp Silent BCC for contact form ───────
# When set, every contact form submission is silently forwarded
# to the recipient WhatsApp number (defaults to 233249783736).
# The website user never sees any WhatsApp mention.
# If not set, WhatsApp forwarding is skipped silently (no error).
#
# Setup:
#   1. https://developers.facebook.com → My Apps → Create App
#   2. Add "WhatsApp" product → get phone_number_id + access token
#   3. Create an approved message template named:
#        contact_form_notification
#      Language: en_US (or en)
#      Body (6 params in this exact order):
#        New contact form submission from {{1}}.
#
#        Name: {{2}}
#        Email: {{3}}
#        Phone: {{4}}
#        Service: {{5}}
#        Message: {{6}}
#   4. Set the three env vars below
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_RECIPIENT="233249783736"

# ── Optional: Strapi CMS ─────────────────────────────────
NEXT_PUBLIC_STRAPI_URL=""

# ── Optional: Supabase ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
