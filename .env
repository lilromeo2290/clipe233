# ─── Database ──────────────────────────────────────────────────────────────────
# For local dev: file:./db/custom.db
# For production (Vercel/serverless): Use Supabase PostgreSQL URL instead
# Example: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=file:./db/custom.db

# ─── Deployment Platform ─────────────────────────────────────────────────────
# Set to "1" when deploying to Vercel or other serverless platforms
# VERCEL=1

# ─── Supabase (replace with real credentials when ready) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Strapi CMS (replace with real credentials when ready) ───────────────────
NEXT_PUBLIC_STRAPI_URL=https://your-strapi-instance.strapi.io
STRAPI_API_TOKEN=your-strapi-api-token
