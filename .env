# ─── Database ──────────────────────────────────────────────────────────────────
# For local dev: file:./db/custom.db (SQLite)
# For production (Vercel/serverless): Use Supabase PostgreSQL URL instead
# Example: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
#
# ⚠️ IMPORTANT: SQLite (file:./db/custom.db) does NOT work on serverless platforms
# like Vercel because they have ephemeral/read-only filesystems.
# When deploying, set DATABASE_URL to a PostgreSQL connection string in your
# deployment platform's environment variables (NOT in this file).
DATABASE_URL=file:./db/custom.db

# ─── Deployment Platform ─────────────────────────────────────────────────────
# Vercel automatically sets VERCEL=1 — you do NOT need to set it here.
# The app auto-detects serverless environments and disables SQLite accordingly.
# Other platforms: Set VERCEL=1 or the appropriate env var for your platform.

# ─── Supabase (replace with real credentials when ready) ─────────────────────
# Create a project at https://supabase.com and paste credentials below
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Strapi CMS (replace with real credentials when ready) ───────────────────
# Deploy Strapi and paste your instance URL and API token below
NEXT_PUBLIC_STRAPI_URL=https://your-strapi-instance.strapi.io
STRAPI_API_TOKEN=your-strapi-api-token
